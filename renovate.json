{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "helm",
  "semanticCommitType": "build",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update appVersion in Chart.yaml when new Docker image is published",
      "managerFilePatterns": [
        "/charts/nextcloud-mcp-server/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ghcr.io/cbcoutinho/nextcloud-mcp-server",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update inline-annotated docker tags (and their optional @sha256 digest) in values.yaml (e.g. qdrant sidecar)",
      "managerFilePatterns": [
        "/charts/.+/values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+tag:\\s*\"?(?<currentValue>[^\"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "appVersion in Chart.yaml is a chart version string that the deployment template uses as the image tag, so it cannot hold a digest. Without this, docker:pinDigests fails the whole pin-dependencies branch.",
      "matchFileNames": [
        "charts/nextcloud-mcp-server/Chart.yaml"
      ],
      "matchDepNames": [
        "ghcr.io/cbcoutinho/nextcloud-mcp-server"
      ],
      "pinDigests": false
    }
  ]
}
